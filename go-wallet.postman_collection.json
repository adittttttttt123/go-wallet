{
	"info": {
		"name": "Go-Wallet API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Create Wallet",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"user_id\": \"USER-A\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/wallets",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"wallets"
					]
				}
			}
		},
		{
			"name": "2. Top Up",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"user_id\": \"USER-A\",\n    \"amount\": 100000\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/wallets/topup",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"wallets",
						"topup"
					]
				}
			}
		},
		{
			"name": "3. Get Balance",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/v1/wallets/USER-A/balance",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"wallets",
						"USER-A",
						"balance"
					]
				}
			}
		},
		{
			"name": "4. Transfer",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"from_user_id\": \"USER-A\",\n    \"to_user_id\": \"USER-B\",\n    \"amount\": 25000\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/wallets/transfer",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"wallets",
						"transfer"
					]
				}
			}
		},
		{
			"name": "5. Get History",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/v1/wallets/USER-A/history",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"wallets",
						"USER-A",
						"history"
					]
				}
			}
		}
	]
}
